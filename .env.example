# Sol-Arb Configuration
# Copy to .env and fill in your values

# Solana RPC endpoint
SOLANA_RPC=https://api.mainnet-beta.solana.com

# Network mode: true = devnet (test), false = mainnet (real funds)
DEV_MODE=true

# Your wallet private key (base58 format)
# Generate: solana-keygen new --outfile wallet.json
# Get base58: cat wallet.json  
PRIVATE_KEY=

# Arbitrage settings
MIN_PROFIT_USD=0.50
MAX_TRADE_USD=100
SLIPPAGE_BPS=100
SCAN_INTERVAL_MS=2000

# Execution
PRIORITY_FEE=10000
MAX_RETRIES=3

# Auto-execute trades without confirmation (DANGEROUS!)
# Leave commented for manual review
# AUTO_EXECUTE=true

# Custom token list (comma-separated mint addresses)
# Leave empty to use default memecoin list
MONITOR_TOKENS=
